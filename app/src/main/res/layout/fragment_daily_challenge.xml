<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/txtStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 Streak: 0 days"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/txtStreakSteps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✔ 1   ✔ 3   ✔ 5   ✔ 7   ✔ 14   ✔ 30"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="32dp"/>

        <!-- WHEEL SECTION -->
        <FrameLayout
            android:id="@+id/wheelContainer"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_marginBottom="32dp">

            <fr.accentweb.speedMath.ui.daily.MagicWheelView
                android:id="@+id/magicWheel"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|center_horizontal"
                android:src="@drawable/star_solid_full"
                app:tint="@color/gold_accent"
                android:rotation="180"/>
        </FrameLayout>

        <!-- TICKET (Visible when waiting reward) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTicket"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/accent_violet"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/ticketFront"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/card_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="🎫 DAILY CHALLENGE"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="22sp"/>

                    <TextView
                        android:id="@+id/txtTicketAction"
                        android:text="Tap to reveal gift"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="italic"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/accent_violet"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ticketBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ticket_gold"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtReward"
                        android:text="🎟 +1 Online Match"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REWARD UNLOCKED!"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnSpin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SPIN TO DECIDE CHALLENGE 🎡"
            android:backgroundTint="@color/accent_violet"
            android:textColor="@color/white"
            android:padding="15dp" />

        <Button
            android:id="@+id/btnPlayOnline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Play Online Now 🚀"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/blue_primary"
            android:textColor="@color/white"
            android:visibility="gone"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Complete the daily task to claim your matches!"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="24dp"
            android:alpha="0.7"/>
    </LinearLayout>
</ScrollView>
